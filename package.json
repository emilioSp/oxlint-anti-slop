{
  "name": "oxlint-anti-slop",
  "version": "0.3.8",
  "description": "Opinionated Oxlint rules for safer, clearer TypeScript in AI-assisted codebases.",
  "keywords": [
    "ai-assisted-development",
    "anti-slop",
    "code-quality",
    "linter",
    "linting",
    "oxlint",
    "oxlint-plugin",
    "static-analysis",
    "typescript"
  ],
  "homepage": "https://github.com/emilioSp/oxlint-anti-slop#readme",
  "bugs": {
    "url": "https://github.com/emilioSp/oxlint-anti-slop/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emilioSp/oxlint-anti-slop.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#utils/*": {
      "types": "./utils/*",
      "default": "./dist/utils/*"
    },
    "#rules/*": {
      "types": "./rules/*",
      "default": "./dist/rules/*"
    },
    "#eslint-stylistic/*": {
      "types": "./vendor/eslint-stylistic/*",
      "default": "./dist/vendor/eslint-stylistic/*"
    },
    "#test/*": "./tests/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "test": "npm run build && vitest run",
    "check": "npm run build && npm run fmt && npm run lint && npm test",
    "prepublishOnly": "npm run check",
    "publish:npm": "npm publish --access public",
    "fmt": "oxfmt",
    "lint": "oxlint --fix"
  },
  "dependencies": {
    "@oxlint/plugins": "1.86.0"
  },
  "devDependencies": {
    "@types/node": "26.6.1",
    "oxfmt": "0.73.0",
    "oxlint": "1.86.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "peerDependencies": {
    "oxlint": ">=1.86.0"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
